<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Chromium's V8 needs JIT and unsigned executable memory under the
       hardened runtime; without these the app crashes on launch once signed. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Required whenever the bundle is ad-hoc signed under the hardened
       runtime (our default — no Developer ID cert is wired up yet). Without
       it macOS library validation refuses to load Electron's own frameworks
       and the app dies on launch. Harmless once a real identity is used. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Talking to mohe.today. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Attaching a receipt image from disk. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
